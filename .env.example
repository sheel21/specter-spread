# Copy to .env (in this folder, or in the folder one level above it) and fill in.
# Never commit the real .env.

# Model access through the Portkey gateway (model: gpt-6-luna). One of these is required.
PORTKEY_API_KEY=
OPENAI_API_KEY=

# SEC asks every client to identify itself with a name and contact email.
SEC_USER_AGENT=Your Name your.email@example.com

# Optional: auto (default) | live | sample  (sample = bundled AAPL data, works offline)
SPECTER_DATA_MODE=auto
